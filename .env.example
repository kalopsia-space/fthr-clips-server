# Copy to .env and edit. Generate secrets with: openssl rand -base64 32
UPLOAD_TOKEN=
ADMIN_PASSWORD=
# Alternative to ADMIN_PASSWORD: an argon2id hash from `fthr-clips-server hash-password`
# ADMIN_PASSWORD_HASH=

PUBLIC_BASE_URL=https://clips.example.com
# Comma-separated IPs/CIDRs of your reverse proxy (trust X-Forwarded-For only from these).
TRUSTED_PROXIES=

# Everything below is optional; the value shown is the default.
# DATA_DIR=/data                 # (STORAGE_DIR is accepted as an alias)
# MAX_UPLOAD_BYTES=524288000
# VIDEO_DIRS=                    # comma-separated, e.g. /videos
# IMAGE_DIRS=                    # comma-separated, e.g. /images
# SCAN_INTERVAL_MINUTES=15
# TRANSCODING=compat             # off | compat | on
# ENCODER=auto                   # auto | x264 | nvenc | vaapi | qsv | videotoolbox
# TRANSCODE_WORKERS=1
# TRANSCODE_TIMEOUT_MINUTES=60
# FFMPEG_PATH=
# FFPROBE_PATH=
# DISCORD_WEBHOOK_URL=
# WEBHOOK_URL=
# SITE_TITLE=FTHR Clips
# LOG_LEVEL=info
# BIND_HOST=127.0.0.1            # the Docker image sets 0.0.0.0
# PORT=8080
